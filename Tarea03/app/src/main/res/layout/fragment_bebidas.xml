<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bebidas"
            android:textSize="32sp"
            android:fontFamily="sans-serif-black"
            android:textColor="#006241"
            android:layout_marginBottom="4dp"/>

        <View
            android:layout_width="60dp"
            android:layout_height="4dp"
            android:background="#006241"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conoce nuestras bebidas de temporada"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#555555"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bebidas calientes"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D2D2D"
            android:layout_marginBottom="16dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_marginBottom="32dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/latte" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Latte Clásico" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$65.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_latte" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_latte" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_latte" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/espresso" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Espresso" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$45.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_espresso" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_espresso" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_espresso" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/chocolate" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chocolate caliente" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$50.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_chocolate" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_chocolate" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_chocolate" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/capuccino" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Capuccino" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$70.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_capuccino" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_capuccino" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_capuccino" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bebidas frías"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D2D2D"
            android:layout_marginBottom="16dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_marginBottom="32dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/tefrio" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Té frío" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$55.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_te" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_te" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_te" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/limonada" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Limonada de fresa" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$40.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_limonada" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_limonada" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_limonada" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/smoothie" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Smoothie Asha" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$80.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_smoothie" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_smoothie" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_smoothie" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/matcha" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Matcha" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$75.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_matcha" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_matcha" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_matcha" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>