<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Snacks y más"
            android:textSize="32sp"
            android:fontFamily="sans-serif-black"
            android:textColor="#006241"
            android:layout_marginBottom="4dp"/>

        <View
            android:layout_width="60dp"
            android:layout_height="4dp"
            android:background="#006241"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lleva la experiencia Mhaisi Coffee a casa"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#555555"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Café en grano y molido"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D2D2D"
            android:layout_marginBottom="16dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_marginBottom="32dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/grano" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grano Oaxaca" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$280.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_oaxaca" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_oaxaca" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_oaxaca" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/molido" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Molido Michoacán" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$265.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_michoacan" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_michoacan" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_michoacan" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Termos y Accesorios"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D2D2D"
            android:layout_marginBottom="16dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_marginBottom="32dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/termo_rosa" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Termo Rosa" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$450.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_rosa" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_rosa" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_rosa" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/aniversario" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Termo Aniversario" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$520.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_aniversario" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_aniversario" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_aniversario" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/tote" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tote Bag Mhaisi" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$190.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_tote" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_tote" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_tote" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Snacks para el camino"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D2D2D"
            android:layout_marginBottom="16dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_marginBottom="32dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/galletas" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Galletas Avena" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$38.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_galletas" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_galletas" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_galletas" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:layout_width="170dp" android:layout_height="wrap_content" android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="#FFFFFF">
                        <com.google.android.material.imageview.ShapeableImageView android:layout_width="110dp" android:layout_height="110dp" android:src="@drawable/mix" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mix Energético" android:textStyle="bold" android:textColor="#333333" android:layout_marginTop="12dp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$42.00" android:textColor="#006241" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="4dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp" android:background="#F5F5F5" android:padding="6dp">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_minus_mix" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="-" android:textColor="#006241" android:textSize="20sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                            <TextView android:id="@+id/tv_count_mix" android:layout_width="35dp" android:layout_height="wrap_content" android:text="0" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btn_plus_mix" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="34dp" android:layout_height="34dp" android:text="+" android:textColor="#006241" android:textSize="18sp" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="17dp" app:strokeColor="#006241" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>